# ==============================================================================
#                      Adresu Plugin Configuration Example
# ==============================================================================
# This is an example configuration file. To use it, copy it to 'config.toml'
# and uncomment/edit the values according to your needs.
#
#   cp config.toml.example config.toml
#
# Table headers are commented out as well. When enabling an option, uncomment
# its section header too (e.g. [filters.rate_limiter]); otherwise the key ends
# up in the previous table and fails validation.
#
# Unrecognized or misplaced keys fail validation and prevent startup.
# On reload, the error is logged and the previous configuration stays active.
# ==============================================================================

# --- Log Settings ---
#[log]
# Log level can be: "debug", "info", "warn", "error".
# Changing the level of a running process requires a restart.
#level = "info"

# Allows overriding the log level for rejections from specific filters.
# By default, all rejections are logged as "warn".
# This is useful to make "less important" rejections less noisy in the logs.
#[log.rejection_levels]
# Example: Rejections by KindFilter (disallowed kind) are a normal situation,
# so we log them as "debug" to avoid cluttering the main log.
#KindFilter = "debug"

# Example: Rejections by FreshnessFilter (old events) are more informational
# than a critical warning.
#FreshnessFilter = "info"

# --- Basic Service Settings ---
#[database]
# Path to the plugin's database directory. It will be created automatically.
# Ensure the directory exists and the application has write permissions.
#path = "./plugin-db"

#[strfry]
# Paths to the strfry executable and its configuration file.
# Required for the plugin to manage strfry (e.g., for banning users).
#executable_path = "/usr/local/bin/strfry"
#config_path     = "/etc/strfry.conf"


# ==============================================================================
#                         Global Relay Policy
# ==============================================================================
#[policy]
# Pubkey of the moderator in HEX format. Required for manual bans via reactions.
#moderator_pubkey = ""

# Emoji used in a reaction to an event to trigger a BAN.
#ban_emoji = "🔨"

# Emoji used in a reaction to an event to trigger an UNBAN.
#unban_emoji = "🔓"

# Moderation reactions are enabled by default, so 'moderator_pubkey' above is
# required. Set an emoji to "" to disable that action; set both to "" to
# disable moderation completely.

# Default duration of a manual ban. Durations use Go syntax: "30m", "24h",
# "720h". There is no day unit, so use hours for multi-day durations.
#ban_duration = "720h"
# Repeated bans can extend an existing ban but never shorten it. Unban first
# if you intentionally need to replace a ban with a shorter duration.


# ==============================================================================
#                    Local Reputation Graph (optional)
# ==============================================================================
# Disabled by default. When enabled, the plugin builds a bounded follow graph
# from the seeds and relays below, ranks it locally, and stores a snapshot in
# the plugin database. The ReputationFilter then checks event authors against
# that local snapshot. No external reputation API is used.
#
# All non-ephemeral events are checked. NIP-01 ephemeral events
# (20000 <= kind < 30000) bypass reputation. Events fail open while no usable
# snapshot exists.
#
# The collector uses these fixed relays first. An optional bounded NIP-65
# outbox fallback can look up only authors those relays missed; it is disabled
# by default and described below.
#
#[reputation]
# Seed authors as 64-character hex public keys. Required when the filter is
# enabled. Collection starts from their kind-3 follow lists.
#seeds = []
#
# Explicit ws:// or wss:// relay URLs with a host. Required when enabled.
# At most 8 URLs. Credentials/userinfo and fragments are rejected.
#relays = []
#
# Optional targeted NIP-65 outbox fallback. When enabled, only authors missing
# from the fixed relays are looked up through the discovery bootstrap relays,
# then queried on their verified write relays. Discovered relays must be wss
# and public; loopback/private/reserved addresses, proxies and redirects are
# blocked. Requires 1..8 bootstrap URLs with the same syntax as relays.
# Static bootstrap URLs may use ws:// loopback for local test deployments.
#discover_relays = false
#discovery_relays = []
#
# How often to refresh the local graph. max_age keeps the last usable snapshot
# available between refreshes and during transient failures.
#refresh_interval = "1h"
#max_age          = "72h" # Must be >= refresh_interval.
#fetch_timeout    = "10s"
#
# Bounded breadth-first traversal. max_depth is the number of BFS levels
# FETCHED: depth 1 fetches seed lists and keeps their targets as boundary
# nodes; depth 2 also fetches direct follows. This is not the global graph.
#max_depth   = 2 # 1..4
#max_nodes   = 50000
#max_edges   = 1000000
#batch_size  = 64
#max_follows = 5000
#
# A snapshot is ready only when coverage reaches min_coverage. Ranking
# parameters apply to the local power iteration.
#min_coverage   = 0.8
#damping        = 0.85
#tolerance      = 0.00000001
#max_iterations = 200


# ==============================================================================
#                            Event Filters
# ==============================================================================
# All filters are disabled unless their section is uncommented.
#[filters]

# --- Kind Filter ---
# NOTE: kind lists belong to [filters.policy], not to [policy] above.
#[filters.policy]
# List of event kinds that your relay WILL accept.
# If 'allowed_kinds' is non-empty, any kind NOT in this list is denied.
#allowed_kinds = [0, 1, 3, 5, 6, 7, 30023]

# List of event kinds that your relay will NOT accept.
# If 'denied_kinds' is non-empty, kinds in this list are denied.
# 'allowed_kinds' and 'denied_kinds' must not overlap.
#denied_kinds = [4, 40, 41, 42, 43, 44]

# --- Freshness Filter ---
# Rejects events that are too old or have a timestamp too far in the future.
#[filters.freshness]
# At this level the keys are default_max_past/default_max_future.
# max_past/max_future are only valid inside a [[filters.freshness.rule]].
# If non-zero, the defaults apply to all kinds that don't have a specific
# rule below; 0 disables that check.
#default_max_past   = "24h"
#default_max_future = "15m"

# You can define specific rules for different kinds.
# If several rules list the same kind, the last one wins. A rule replaces both
# default limits for its kinds, so set both max_past and max_future in it
# (0 or omitted means no limit).
# [[filters.freshness.rule]]
# description    = "Allow old articles, but new ones should be recent"
# kinds          = [30023]
# max_past       = "168h" # Long-form articles can be up to 7 days old.
# max_future     = "15m"

# [[filters.freshness.rule]]
# description    = "Strict freshness for chats"
# kinds          = [9]
# max_past       = "5m" # Chats should be very recent.
# max_future     = "1m"

# --- Event Size Filter ---
#[filters.size]
# Default size limit in bytes for all kinds without a specific rule.
#default_max_size_bytes = 16384 # 16 KiB

# You can define specific rules for different kinds.
# A rule overrides default_max_size_bytes for its kinds; 0 means unlimited.
#[[filters.size.rule]]
#description    = "Limit long-form articles to 100 KiB"
#kinds          = [30023]
#max_size_bytes = 102400

# --- Tags Filter ---
# Sets limits on event tags. If several rules list the same kind, the last one wins.
#[filters.tags]
#[[filters.tags.rule]]
#description    = "Rules for standard notes"
#kinds          = [1]
#max_tags       = 10 # Maximum total number of tags.
#required_tags  = [] # List of required tag names (e.g., ["e", "p"]).
#max_tag_counts = { p = 4 } # Max count for specific tags (e.g., max 4 '#p' tags).

# --- Keyword and Regular Expression Filter ---
#[filters.keywords]
#enabled = false
#[[filters.keywords.rule]]
#description = "Block specific spam words or patterns"
#kinds       = [1]
#words       = ["spamword1", "spamword2"] # Case-insensitive words.
#regexps     = ["https?://spam-domain\\.com"] # Regular expressions.

# --- Ephemeral Chats Filter ---
#[filters.ephemeral_chat]
#enabled                    = false
#kinds                      = [20000, 23333] # Kinds to apply these rules to.
#min_delay_between_messages = "1s" # Anti-flood delay between messages from the same user.
#max_caps_ratio             = 0.0  # 0.0 to disable. Max ratio of uppercase letters (e.g., 0.5 = 50%).
#min_letters_for_caps_check = 20   # Minimum number of letters to trigger caps check.
#max_character_repetitions  = 0    # Rejects an actual repeated run of at least this length; 0 disables, 1 rejects any adjacent repetition.
#max_word_length            = 120  # Rejects a non-whitespace run of at least this length.
#block_zalgo_text           = true # Blocks text containing combining marks used for Zalgo; one mark is enough.
#cache_size                 = 10000 # In-memory cache size for tracking users.
#rate_limit_rate            = 0.166 # Events per second if PoW is not used. ~10/min.
#rate_limit_burst           = 5     # Burst allowance for the rate limiter.
#required_pow_on_limit      = 12    # Required PoW difficulty if rate limit is exceeded.
# Set both rate_limit_rate and rate_limit_burst to 0 to require PoW for every message.

# --- Language Filter ---
#[filters.language]
#enabled                = false
#allowed_languages      = ["en", "ja", "ru"] # English names or ISO 639-1 codes.
#kinds_to_check         = [1, 30023]
#min_length_for_check   = 20 # Skip check for very short texts.
#approved_cache_ttl     = "30m" # Cache duration for authors who pass the check.
#approved_cache_size    = 10000
# Special thresholds for similar languages. Example: allows Russian if detected as Ukrainian.
# Every primary key must also appear in allowed_languages using the same spelling.
#[filters.language.primary_accept_threshold.ru]
#uk = 0.0002
#default = 0.018 # Default minimum confidence for a language to be accepted as Russian.

# --- Emergency Filter ---
#[filters.emergency]
#enabled      = false
#new_keys_rate  = 100.0 # Global rate of NEW pubkeys allowed per second.
#new_keys_burst = 200 # Global burst allowance for the new key rate limiter.
#cache_size     = 10000 # How many unique pubkeys to remember as "recently seen".
#ttl            = "10s" # How long a pubkey is considered "not new" after its first appearance.

# --- Per-IP Emergency Settings ---
#[filters.emergency.per_ip]
#enabled    = false
#rate       = 5.0 # Rate of NEW pubkeys allowed per second from a single IP/subnet.
#burst      = 10 # Burst allowance for the per-IP rate limiter.
#cache_size = 10000 # How many unique IP/subnet limiters to keep in memory.
#ttl        = "1m" # How long a limiter for an inactive IP/subnet is kept in memory.

# --- IP Normalization ---
# These keys belong to [filters.emergency.per_ip] and are used only when
# per_ip.enabled = true. If a prefix is > 0, groups IPs into subnets.
# 0 or absent = disabled.
#ipv4_prefix = 0 # CIDR prefix for IPv4 addresses (e.g., 24).
#ipv6_prefix = 0 # CIDR prefix for IPv6 addresses (e.g., 64).

# --- Global Rate Limiter ---
#[filters.rate_limiter]
#enabled       = false
#by            = "both" # Limit by "ip", "pubkey", or "both". Defaults to "both".
#cache_size    = 65536
#ttl           = "10m" # How long an entry stays in cache after last activity.
#default_rate  = 0.5  # Default events per second.
#default_burst = 5    # Default burst allowance.
#[[filters.rate_limiter.rule]]
#description = "Exclude Ephemeral Chats (handled by their own filter)"
#kinds       = [20000, 23333]
#rate        = 0
#burst       = 1
#[[filters.rate_limiter.rule]]
#description = "Stricter limit for creating articles"
#kinds       = [30023]
#rate        = 0.0017 # ~1 article per 10 minutes
#burst       = 1

# --- Repost Abuse Filter ---
#[filters.repost_abuse]
#enabled                  = false
#max_ratio                = 0.7 # Rejects repost shares >= 70% of tracked posts (kinds 6/16 and kind-1 q-tag quotes count as reposts).
#min_events               = 20  # Minimum number of events from a user before this filter applies.
#reset_duration           = "12h" # User's activity ratio resets after this period of inactivity.
#cache_size               = 10000 # Maximum number of unique users to track in memory at once.
#cache_ttl                = "24h" # How long user activity data is kept in cache.
#count_reject_as_activity = false # Rejected repost attempts refresh the inactivity timestamp; other filters' rejections are not observed.
#require_nip21_in_quote   = false # Only count kind-1 q-tag quotes as reposts when content contains a note/nevent/naddr reference.

# --- Reputation Filter ---
# Disabled by default. When enabled, requires [reputation] seeds and relays.
# TrustRank is a raw score in [0,1], not a percentage. A known author must
# meet the configured minimum. A zero minimum in enforce mode checks only
# membership in the bounded graph; this is NOT Sybil-resistant. Choose a
# threshold from observe-mode data instead of assuming a default is safe.
#
# Upgrading: remove filters.reputation.min_pagerank from existing configs
# before starting this version; unknown keys are rejected.
#
# mode = "observe" records would-reject assessments for logging and lets the
# event continue through the rest of the pipeline. mode = "enforce" rejects
# with a "restricted: ..." reason. This is separate from the global -dry-run
# option, which suppresses all rejections.
#
# Ephemeral kinds (20000 <= kind < 30000) always bypass this filter. Events
# pass when the snapshot is missing, stale, or not ready.
#
# Reputation logs use separate messages without remote IPs, not ordinary
# abuse-rejection records. Exclude them from broader custom ban rules. See
# docs/reputation.md for the full operational notes.
#
#[filters.reputation]
#enabled       = false
#mode          = "observe"
#min_trustrank = 0.0

# --- Banned Author Filter ---
#[filters.banned_author]
# If true, the filter will perform full NIP-26 validation to detect
# and block events from banned delegators. This prevents ban evasion.
# It is disabled by default because it adds a small cryptographic workload.
#check_nip26 = true

# --- Automatic Ban Filter (Autoban) ---
#[filters.autoban]
#enabled             = false
#max_strikes         = 10 # Ban after this many distinct, validly signed rejected events...
#strike_window       = "1h" # ...if they occurred within this time window.
#ban_duration        = "24h" # Duration of the automatic ban.
#strikes_cache_size  = 10000
#cooldown_cache_size = 1000
#cooldown_duration   = "1m" # No new strikes for this duration after an automatic ban is triggered.
#ban_timeout         = "10s" # timeout for DB ban op (0/absent => fallback 5s)
# List of filters whose rejections DO NOT result in a 'strike'.
#exclude_filters_from_strikes = ["RateLimiterFilter", "FreshnessFilter"]
